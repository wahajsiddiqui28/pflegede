# Pflegede — uploads protection
Options -Indexes

<FilesMatch "\.(php|phtml|phar|php7|phps|pl|py|jsp|asp|sh|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>
